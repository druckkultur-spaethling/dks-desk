# Leer lassen, wenn die App auf einer eigenen Domain oder im Root läuft.
# Bei Einbindung in eine Webflow-Seite z. B. /portal verwenden.
WEBFLOW_CLOUD_MOUNT_PATH=/portal

# Optional: echte KI-Auswertung von Bestell-PDFs.
# Ohne Schlüssel verwendet die App eine klar gekennzeichnete Vorführanalyse.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
